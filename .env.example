# ============================================================
# FinCheck 环境变量模板
# 用法：复制本文件为 .env，填入真实密钥。
#      .env 已被 .gitignore 排除，不会进入仓库。
# ============================================================

# ---------- 当前启用的大模型 ----------
# 可选值：deepseek / qwen / glm / kimi / ollama / mock
#   glm   = 智谱 GLM-4-Flash（永久免费，开发期启用）
#   mock  = 离线模拟，零密钥零成本，仅用于验证链路，不产生真实结论
# 开发期建议：glm；决赛定稿：deepseek
FINCHECK_LLM_PROFILE=glm

# ---------- 各厂商密钥（只需填当前启用那一个）----------

# 开发期：智谱 AI（https://open.bigmodel.cn）
#   注册 → 实名认证 → API 密钥 → 创建，复制形如 xxxx.yyyy 的密钥
ZHIPUAI_API_KEY=

# 决赛首选：深度求索 DeepSeek（https://platform.deepseek.com）
DEEPSEEK_API_KEY=

# 备用：阿里云百炼（https://bailian.console.aliyun.com）
DASHSCOPE_API_KEY=

# 备用：月之暗面 Kimi（https://platform.moonshot.cn）
MOONSHOT_API_KEY=

# ---------- 可选覆盖项 ----------
# 留空则使用 src/agent/model_provider.py 中的默认值
FINCHECK_LLM_MODEL=
FINCHECK_LLM_BASE_URL=
FINCHECK_LLM_TEMPERATURE=0
FINCHECK_LLM_MAX_TOKENS=4096
FINCHECK_LLM_TIMEOUT=120
